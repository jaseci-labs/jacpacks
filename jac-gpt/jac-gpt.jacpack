{
  "name": "jac-gpt",
  "description": "Jac GPT fullstack template with chat interface",
  "config": {
    "project": {
      "name": "jac-gpt-client",
      "version": "1.0.0",
      "description": "Jac client application: jac-gpt-client",
      "entry-point": "main.jac"
    },
    "dependencies": {
      "python-dotenv": ">=0.0.0",
      "requests": ">=0.0.0",
      "langchain-openai": ">=0.0.0",
      "langchain-community": ">=0.0.0",
      "langchain-chroma": ">=0.0.0",
      "pypdf": ">=0.0.0",
      "sentence-transformers": ">=0.0.0",
      "faiss-cpu": ">=0.0.0",
      "npm": {
        "jac-client-node": "1.0.7",
        "react-markdown": "^9.0.0",
        "rehype-highlight": "^7.0.0",
        "highlight.js": "^11.9.0",
        "clsx": "^2.1.0",
        "tailwind-merge": "^2.2.0",
        "@mantine/core": "^7.15.0",
        "@mantine/hooks": "^7.15.0",
        "@tabler/icons-react": "^3.28.0",
        "@emotion/react": "^11.14.0",
        "react-error-boundary": "latest",
        "@codemirror/view": "^6.0.0",
        "@codemirror/state": "^6.0.0",
        "@codemirror/language": "^6.0.0",
        "@lezer/highlight": "^1.0.0",
        "monaco-textmate": "^3.0.1",
        "monaco-editor-textmate": "^4.0.0",
        "dev": {
          "@jac-client/dev-deps": "1.0.0"
        }
      }
    },
    "dev-dependencies": {
      "watchdog": ">=3.0.0"
    },
    "serve": {
      "base_route_app": "app"
    },
    "plugins": {
      "client": {},
      "scale": {
        "kubernetes": {
          "app_name": "jac-gpt-test",
          "namespace": "jac-gpt-test",
          "jaseci_repo_url": "https://github.com/udithishanka/jaseci.git",
          "jaseci_branch": "fix/byllm-streaming-cross-context-token-reset",
          "liveness_initial_delay": 600,
          "liveness_period": 30,
          "liveness_failure_threshold": 10,
          "readiness_initial_delay": 600,
          "readiness_period": 30,
          "cpu_request": "1000m",
          "cpu_limit": "3000m",
          "memory_request": "2Gi",
          "memory_limit": "6Gi",
          "ephemeral_storage_request": "20Gi",
          "ephemeral_storage_limit": "30Gi"
        },
        "secrets": {
          "OPENAI_API_KEY": "${OPENAI_API_KEY}"
        }
      }
    }
  },
  "files": {
    "frontend.cl.jac": "\"\"\"Main entry point for Jac GPT Client application.\"\"\"\nimport from react { useEffect }\nimport from \"@jac/runtime\" { Router, Routes, Route }\nimport from \"@mantine/core\" { MantineProvider, createTheme }\n\nimport from .pages.JacChatbot { JacChatbot }\nimport from .pages.LoginPage { LoginPage }\nimport from .pages.RegisterPage { RegisterPage }\nimport from .pages.ForgotPasswordPage { ForgotPasswordPage }\nimport from .pages.ResetPasswordPage { ResetPasswordPage }\nimport from .pages.AdminDashboard { AdminDashboard }\nimport from .utils.ProtectedRoute { ProtectedRoute }\n\nimport from \".utils.monaco_initializer\" { initializeMonacoGlobally }\n\nimport \"@mantine/core/styles.css\";\nimport \".global.css\";\n\n\"\"\"Main app component with routing.\"\"\"\ndef:pub app() -> JsxElement {\n    useEffect(lambda {\n        async def initMonaco() -> None {\n            try {\n                await initializeMonacoGlobally();\n            } except Exception {\n            }\n        }\n\n        initMonaco();\n    }, []);\n    # Custom Mantine theme for dark mode\n    theme = createTheme({\n        \"primaryColor\": \"violet\",\n        \"defaultRadius\": \"md\",\n        \"fontFamily\": \"Inter, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif\",\n        \"colors\": {\n            \"dark\": [\n                \"#C1C2C5\",\n                \"#A6A7AB\",\n                \"#909296\",\n                \"#5c5f66\",\n                \"#373A40\",\n                \"#2C2E33\",\n                \"#25262b\",\n                \"#1A1B1E\",\n                \"#141517\",\n                \"#101113\"\n            ]\n        }\n    });\n\n    return <MantineProvider theme={theme} defaultColorScheme=\"dark\">\n        <Router>\n            <Routes>\n                <Route path=\"/\" element={<JacChatbot />} />\n                <Route path=\"/login\" element={<LoginPage />} />\n                <Route path=\"/register\" element={<RegisterPage />} />\n                <Route path=\"/forgot-password\" element={<ForgotPasswordPage />} />\n                <Route path=\"/reset-password\" element={<ResetPasswordPage />} />\n                <Route path=\"/dashboard\" element={<ProtectedRoute><AdminDashboard /></ProtectedRoute>} />\n            </Routes>\n        </Router>\n    </MantineProvider>;\n}\n",
    "main.jac": "\"\"\"Backend entry point for Jac GPT Client application.\"\"\"\n\n\nimport from services.jacServer {\n        Session,\n        Router,\n        RagChat,\n        QAChat,\n        CodingChat,\n        DebuggerChat,\n        OffTopicChat,\n        new_session,\n        get_session,\n        interact,\n        suggest_docs,\n        get_doc_content,\n        get_user_profile,\n        create_user_profile,\n        save_user_location,\n        get_all_users,\n        get_all_sessions_admin,\n        get_session_messages_admin,\n        get_documentation_urls,\n        get_session_stats,\n        close_session,\n        search_docs,\n        refer_full_language_examples\n    }\n\n# Client-side code - must be explicitly imported after .cl.jac auto-annexing was removed\ncl {\n    import from .frontend { app as ClientApp }\n\n    def:pub app() -> JsxElement {\n        return <ClientApp />;\n    }\n}",
    "README.md": "# jac-gpt\n\nA documentation assistant for Jac, built entirely in Jac.\n\n## Getting Started\n\n1. Clone the repository:\n\n```bash\ngit clone https://github.com/jaseci-labs/Agentic-AI.git\ncd Agentic-AI/jac-gpt-fullstack\n```\n\n2. Install dependencies:\n\n```bash\njac install\n```\n\n3. Set environment variables:\n\n```bash\nexport OPENAI_API_KEY=your_openai_api_key\n```\n\n4. Start the application:\n\n```bash\njac start main.jac\n```\n\n## Project Structure\n\n```\njac-gpt-fullstack/\n\u251c\u2500\u2500 jac.toml              # Project configuration\n\u251c\u2500\u2500 main.jac              # Main application entry\n\u251c\u2500\u2500 components/           # Reusable components\n\u2514\u2500\u2500 assets/               # Static assets\n```\n",
    "global.css": "/* Global styles for Jac GPT Client with Mantine */\n\n:root {\n    /* Dark theme colors - matching violet/purple brand */\n    --background: #0a0a0f;\n    --surface: #0f0f15;\n    --surface-hover: #16161f;\n    --border: rgba(255, 255, 255, 0.06);\n    --border-light: rgba(255, 255, 255, 0.1);\n\n    /* Text colors */\n    --text-primary: #fafafa;\n    --text-secondary: #a1a1aa;\n    --text-muted: #71717a;\n\n    /* Brand colors - violet/purple theme */\n    --primary: #7c3aed;\n    --primary-light: #a855f7;\n    --primary-hover: #6d28d9;\n    --secondary: #8b5cf6;\n\n    /* Status colors */\n    --success: #22c55e;\n    --error: #ef4444;\n    --warning: #eab308;\n\n    /* Gradients */\n    --gradient-primary: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);\n    --gradient-secondary: linear-gradient(135deg, #8b5cf6 0%, #c084fc 100%);\n}\n\n* {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n}\n\nhtml, body {\n    height: 100%;\n    font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n    background-color: var(--background);\n    color: var(--text-primary);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n}\n\n#root {\n    height: 100%;\n}\n\n/* Scrollbar styling */\n::-webkit-scrollbar {\n    width: 6px;\n    height: 6px;\n}\n\n::-webkit-scrollbar-track {\n    background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n    background: rgba(255, 255, 255, 0.2);\n}\n\n/* Animations */\n@keyframes fadeIn {\n    from { opacity: 0; }\n    to { opacity: 1; }\n}\n\n@keyframes slideUp {\n    from {\n        opacity: 0;\n        transform: translateY(10px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n@keyframes slideIn {\n    from {\n        opacity: 0;\n        transform: translateX(-10px);\n    }\n    to {\n        opacity: 1;\n        transform: translateX(0);\n    }\n}\n\n@keyframes pulse {\n    0%, 100% {\n        opacity: 1;\n    }\n    50% {\n        opacity: 0.5;\n    }\n}\n\n@keyframes glow {\n    0%, 100% {\n        box-shadow: 0 0 5px var(--primary), 0 0 10px var(--primary);\n    }\n    50% {\n        box-shadow: 0 0 20px var(--primary), 0 0 30px var(--primary);\n    }\n}\n\n/* Mantine overrides for dark theme */\n.mantine-Paper-root {\n    background-color: var(--surface) !important;\n}\n\n.mantine-Textarea-input,\n.mantine-TextInput-input {\n    background-color: rgba(255, 255, 255, 0.05) !important;\n    border-color: var(--border-light) !important;\n}\n\n.mantine-Textarea-input:focus,\n.mantine-TextInput-input:focus {\n    border-color: var(--primary) !important;\n}\n\n.mantine-Textarea-input::placeholder,\n.mantine-TextInput-input::placeholder {\n    color: var(--text-muted) !important;\n}\n\n/* Code block styling */\npre {\n    background-color: rgba(0, 0, 0, 0.4) !important;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    padding: 1rem;\n    overflow-x: auto;\n}\n\ncode {\n    font-family: 'JetBrains Mono', 'Fira Code', 'Monaco', 'Consolas', monospace;\n    font-size: 0.875rem;\n}\n\n/* Inline code */\n:not(pre) > code {\n    background-color: rgba(124, 58, 237, 0.15);\n    color: #c084fc;\n    padding: 0.125rem 0.375rem;\n    border-radius: 4px;\n    font-size: 0.875em;\n}\n\n/* Highlight.js theme overrides for dark mode */\n.hljs {\n    background: transparent !important;\n    color: #e4e4e7 !important;\n}\n\n.hljs-keyword { color: #c084fc; }\n.hljs-string { color: #86efac; }\n.hljs-number { color: #fbbf24; }\n.hljs-function { color: #60a5fa; }\n.hljs-comment { color: #6b7280; font-style: italic; }\n.hljs-variable { color: #f87171; }\n.hljs-attr { color: #fbbf24; }\n.hljs-built_in { color: #22d3ee; }\n.hljs-title { color: #60a5fa; }\n.hljs-params { color: #e4e4e7; }\n.hljs-literal { color: #f472b6; }\n\n/* Selection colors - Orange theme */\n::selection {\n    background-color: rgba(249, 115, 22, 0.3);\n    color: white;\n}\n\n::-moz-selection {\n    background-color: rgba(249, 115, 22, 0.3);\n    color: white;\n}\n\n/* Focus outline for accessibility */\n:focus-visible {\n    outline: 2px solid var(--primary);\n    outline-offset: 2px;\n}\n\n/* Link styling */\na {\n    color: var(--primary-light);\n    text-decoration: none;\n    transition: color 0.2s ease;\n}\n\na:hover {\n    color: var(--primary);\n}\n\n/* Remove Mantine's default focus ring in some cases */\n.mantine-ActionIcon-root:focus,\n.mantine-Button-root:focus {\n    outline: none;\n}\n\n/* Custom utility animations */\n.animate-fadeIn {\n    animation: fadeIn 0.3s ease-in-out;\n}\n\n.animate-slideUp {\n    animation: slideUp 0.3s ease-out;\n}\n\n.animate-slideIn {\n    animation: slideIn 0.3s ease-out;\n}\n\n.animate-pulse {\n    animation: pulse 2s infinite;\n}\n\n.animate-glow {\n    animation: glow 2s ease-in-out infinite;\n}\n\n/* Hide scrollbar but keep functionality */\n.hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n}\n\n.hide-scrollbar::-webkit-scrollbar {\n    display: none;\n}\n\n/* Responsive helpers */\n@media (max-width: 1024px) {\n    .lg\\:hidden {\n        display: none;\n    }\n}\n\n@media (min-width: 1024px) {\n    .lg\\:flex {\n        display: flex;\n    }\n    .lg\\:block {\n        display: block;\n    }\n}",
    "assets/language-configuration.json": "{\n  \"comments\": {\n    \"lineComment\": \"#\",\n    \"blockComment\": [\"#*\", \"*#\"]\n  },\n  \"brackets\": [\n    [\"{\", \"}\"],\n    [\"[\", \"]\"],\n    [\"(\", \")\"]\n  ],\n  \"autoClosingPairs\": [\n    { \"open\": \"{\", \"close\": \"}\" },\n    { \"open\": \"[\", \"close\": \"]\" },\n    { \"open\": \"(\", \"close\": \")\" },\n    { \"open\": \"\\\"\", \"close\": \"\\\"\" },\n    { \"open\": \"'\", \"close\": \"'\" }\n  ]\n}",
    "assets/onigasm.wasm": "base64:",
    "assets/jac.tmLanguage.json": "{\n\t\"name\": \"The Jac Programming Language\",\n\t\"scopeName\": \"source.jac\",\n\t\"fileTypes\": [\"jac\"],\n\t\"patterns\": [\n\t\t{\n\t\t\t\"include\": \"#elements\"\n\t\t}\n\t],\n\t\"repository\": {\n\t\t\"elements\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#import\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#global\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#sem\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#archetype\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#archetype_refdef\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#has\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#ability\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"include\": \"#general\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"import\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"begin\": \"\\\\b(?<!\\\\.)(import|include)\\\\b\",\n\t\t\t\t\t\"end\": \";|}\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"keyword.control.import.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"patterns\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#comments\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"keyword.control.import.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b(?<!\\\\.)(as|from)\\\\b\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"punctuation.separator.jac\",\n\t\t\t\t\t\t\t\"match\": \",|:\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"variable.language.special.self.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b(?<!\\\\.)(py|jac)\\\\b\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"entity.name.namespace.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b(?<!:)([[:alpha:]_]\\\\w*)\\\\b\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"global\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"name\": \"meta.property.jac\",\n\t\t\t\t\t\"begin\": \"(?x)\\\\b(glob|let)\\\\b(?=\\\\s*[[:alpha:]_]\\\\w*|\\\\s*\\\\n)\",\n\t\t\t\t\t\"end\": \";\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"storage.type.variable.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"endCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"punctuation.section.class.begin.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"patterns\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#comments\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"punctuation.separator.jac\",\n\t\t\t\t\t\t\t\"match\": \",\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#general\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"entity.name.type.property.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b([[:alpha:]_]\\\\w*)\\\\s*(?=\\\\=)\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"sem\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"name\": \"meta.semstring.jac\",\n\t\t\t\t\t\"begin\": \"(?x)\\\\b(sem)\\\\b(?=\\\\s*[[:alpha:]_]\\\\w*|\\\\s*\\\\n)\",\n\t\t\t\t\t\"end\": \";\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"storage.type.semstring.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"endCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"punctuation.terminator.statement.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"patterns\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#comments\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"keyword.operator.assignment.jac\",\n\t\t\t\t\t\t\t\"match\": \"=\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"keyword.operator.assignment.jac\",\n\t\t\t\t\t\t\t\"match\": \"is\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#string\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"entity.name.function.semstring.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b([[:alpha:]_]\\\\w*)\\\\b(?=\\\\s*=)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"entity.name.namespace.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b([[:alpha:]_]\\\\w*)\\\\b\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"archetype\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"name\": \"meta.class.jac\",\n\t\t\t\t\t\"begin\": \"(?x)\\\\b(enum|obj|class|node|edge|walker|test)\\\\b(?=\\\\s+[[:alpha:]_]\\\\w*|\\\\s*({|;|\\\\n))\",\n\t\t\t\t\t\"end\": \"(?={)|;\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"storage.type.class.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"endCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"punctuation.section.class.begin.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"patterns\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#class-name\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#class-inheritance\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"archetype_refdef\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"name\": \"meta.class.jac\",\n\t\t\t\t\t  \"begin\": \"(impl|sem)\",\n\t\t\t\t\t\"end\": \"(?=:|{|\\\\W)\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"storage.type.class.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"endCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"punctuation.section.class.begin.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"patterns\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"include\": \"#comments\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"name\": \"entity.name.type.class.jac\",\n\t\t\t\t\t\t\t\"match\": \"\\\\b([[:alpha:]_]\\\\w*)\\\\b\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t\"ability\": {\n\t\t\t\"patterns\": [\n\t\t\t\t{\n\t\t\t\t\t\"name\": \"meta.function.jac\",\n\t\t\t\t\t  \"begin\": \"(?x)\\\\b(can|with|def|impl|sem)\\\\b(?=\\\\s*[[:alpha:]_]\\\\w*|\\\\s*({|;|\\\\(||\\\\n))\",\n\t\t\t\t\t\"end\": \"(?=\\\\)|{)|;\",\n\t\t\t\t\t\"beginCaptures\": {\n\t\t\t\t\t\t\"1\": {\n\t\t\t\t\t\t\t\"name\": \"storage.type.function.jac\"\n\t\t\t\t\t\t}\n\t\t\t\t\t},\n\t\t\t\t\t\"endCaptures\": {\n\t\t\t\t\